{
  "name": "dsh-startup-command",
  "version": "1.5.1",
  "description": "Runs enabled PowerShell, CMD, Bash and Python presets in user-defined order when DSH starts, spaces launches by 500 ms, shows live output and preset management in the left sidebar, and terminates each managed process tree on stop, restart, disable, or exit.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./icon": "./icon.svg",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "author": "Fuxfantx",
  "license": "MIT-0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Fuxfantx/dsh-startup-command.git"
  },
  "homepage": "https://github.com/Fuxfantx/dsh-startup-command#readme",
  "bugs": {
    "url": "https://github.com/Fuxfantx/dsh-startup-command/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "startup",
    "process-manager",
    "powershell",
    "cordis-plugin"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  }
}
